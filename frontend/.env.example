# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Railway production (pick one):
# A) Public API URL (simplest) — must be https://….up.railway.app, NOT *.railway.internal
# NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app
#
# B) Same-origin proxy — leave NEXT_PUBLIC empty and set BACKEND_URL for Next rewrites
# NEXT_PUBLIC_API_URL=
# BACKEND_URL=http://YOUR-BACKEND.railway.internal:PORT
