APP_NAME=House Renovation API
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL (edit these) ---
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renovation
# Leave DATABASE_URL empty to use DB_* above. Set only if you want a full override.
DATABASE_URL=

UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3000

# Google Gemini (vision / optional HQ image)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_GEMINI_HQ=false

# Cloudflare Workers AI (redesign)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning

# Estimation defaults
DEFAULT_DOOR_WIDTH_FT=3.0
DEFAULT_DOOR_HEIGHT_FT=7.0
DEFAULT_WINDOW_WIDTH_FT=4.0
DEFAULT_WINDOW_HEIGHT_FT=4.0
DEFAULT_WASTAGE_PERCENT=10.0
