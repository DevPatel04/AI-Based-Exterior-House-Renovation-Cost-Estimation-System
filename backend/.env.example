APP_NAME=House Renovation API
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL (edit these) ---
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renovation
# Leave DATABASE_URL empty to use DB_* above. Set only if you want a full override.
DATABASE_URL=

UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3000

# Google Gemini (optional — NOT required for redesign)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_GEMINI_HQ=false

# Cloudflare Workers AI — PRIMARY free redesign (10k Neurons/day)
# Docs: https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img

# Hugging Face Inference (SegFormer detect + optional img2img backup)
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=
ENABLE_SEGFORMER=true
SEGFORMER_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
ENABLE_DEPTH_SCALE=true
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
ENABLE_HF_IMG2IMG=true
HF_IMG2IMG_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Replicate ControlNet (preferred when fal has no free credits)
# Free trial credit: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
ENABLE_REPLICATE_CONTROLNET=true
REPLICATE_CONTROLNET_MODEL=lucataco/sdxl-controlnet
REPLICATE_CONTROLNET_SCALE=0.65
REPLICATE_CONTROLNET_STEPS=28
REPLICATE_DEPTH_MODEL=chenxwh/depth-anything-v2
REPLICATE_SEG_MODEL=schananas/grounded_sam
REPLICATE_DINO_MODEL=adirik/grounding-dino
# Demo green-overlay preview when AI fails (default off — API returns 503 with reasons)
ALLOW_LOCAL_REDESIGN_FALLBACK=false

# fal.ai ControlNet (optional — only if you have fal credits)
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
ENABLE_FAL_CONTROLNET=true
FAL_CONTROLNET_MODEL=fal-ai/fast-sdxl-controlnet-canny
FAL_CONTROLNET_SCALE=0.65
FAL_CONTROLNET_STEPS=28

# Estimation defaults
DEFAULT_DOOR_WIDTH_FT=3.0
DEFAULT_DOOR_HEIGHT_FT=7.0
DEFAULT_WINDOW_WIDTH_FT=4.0
DEFAULT_WINDOW_HEIGHT_FT=4.0
DEFAULT_WASTAGE_PERCENT=10.0
