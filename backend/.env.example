APP_NAME=House Renovation API
ENVIRONMENT=development
# Local only — on Railway set ENVIRONMENT=production and a real SECRET_KEY (32+ random chars)
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL (edit these) ---
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renovation
DATABASE_URL=

UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3000

# Google Gemini (optional — quality notes only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_GEMINI_HQ=false

# Cloudflare Workers AI — ONLY redesign engine (required)
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
# Describes the uploaded photo → injected into redesign prompt
CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
ENABLE_IMAGE_DESCRIBE=true
ENABLE_CLOUDFLARE_REDESIGN=true

# Other redesign engines (disabled)
ENABLE_POLLINATIONS_NANOBANANA=false
ENABLE_NANO_BANANA=false
ENABLE_REPLICATE_IMG2IMG=false
ENABLE_REPLICATE_CONTROLNET=false
ENABLE_FAL_CONTROLNET=false
ALLOW_LOCAL_REDESIGN_FALLBACK=false

# Hugging Face — SegFormer structure detection (recommended)
# https://huggingface.co/settings/tokens
HF_TOKEN=
ENABLE_SEGFORMER=true
SEGFORMER_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
ENABLE_DEPTH_SCALE=true
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# Replicate — Grounded-SAM structure detect only (not redesign)
REPLICATE_API_TOKEN=
REPLICATE_SEG_MODEL=schananas/grounded_sam

# Estimation defaults
DEFAULT_DOOR_WIDTH_FT=3.0
DEFAULT_DOOR_HEIGHT_FT=7.0
DEFAULT_WINDOW_WIDTH_FT=4.0
DEFAULT_WINDOW_HEIGHT_FT=4.0
DEFAULT_WASTAGE_PERCENT=10.0
